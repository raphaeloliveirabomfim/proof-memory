# CockroachDB Cloud (Serverless) — connection URL do cluster
# Obtida via: ccloud cluster sql <cluster> --connection-url --username <user> --password <pw>
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# AWS Bedrock (mesma regiao do cluster: us-east-1)
AWS_REGION=us-east-1
# Credenciais AWS via ambiente padrao (~/.aws/credentials, SSO, ou variaveis abaixo)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Modelos Bedrock
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
